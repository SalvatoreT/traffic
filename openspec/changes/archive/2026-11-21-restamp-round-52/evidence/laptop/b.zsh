#!/bin/zsh
# Restamp of round 52, steps 3 and 4 (after a.zsh passed): validate, the published ten-seed assessment, then the proposal search with
# round 52's flags and seeding inputs. Every output is compared with the published one after the stamps (fingerprint, revision, date) are
# set aside. Stops on any difference. No data:push, no /api/, no upload token. Holds the worktree lock.
cd "$(git rev-parse --show-toplevel)" || exit 1
A=target/restamp52; S=$A/search; K=target/batches/worktree.lock; PB=$A/pd-before
EV52=openspec/changes/archive/2026-11-20-calibration-round-52/evidence
FP=6b886c8f52ee07397773ddd0ebbcb447
now() { date '+%Y-%m-%d %I:%M:%S %p %Z'; }
log() { echo "$(now) $*" | tee -a $A/chain.log; }
h() { shasum -a 256 "$1" | cut -c1-16; }
stop() { log "STOP: $*"; log "status: $(git status --short | tr '\n' ';')"; rm -rf $K; log "B DONE (stopped)"; exit 1; }
step() { local name=$1; shift; log "$name: start"; local S0=$(date +%s); "$@" > $A/$name.log 2>&1; local RC=$?; log "$name: exit=$RC wall_s=$(( $(date +%s) - S0 ))"; return $RC; }
norm() { sed -E 's/(d45a275dd7be|6b886c8f52ee)[0-9a-f]*/FP/g; s/revision [0-9a-f]{7,40}(-dirty)?/revision REV/g; /^Generated by/s/ on 2026-[0-9]{2}-[0-9]{2}\./ on DATE./'; }
mkdir $K 2>/dev/null || { echo "lock held: $(cat $K/owner 2>/dev/null)"; exit 1; }; echo "restamp52-B $$ $(date)" > $K/owner
log "START restamp of round 52, steps 3-4, at $(git rev-parse --short HEAD)"

ST=$(git status --short | grep -v '^?? .agents/$')
[ -z "$ST" ] || stop "tree not clean before start: $(echo $ST | tr '\n' ';')"
I="config $(h data/demand/rockridge.config.json) network $(h public/data/rockridge.network.json) demand $(h public/data/rockridge.demand.json) cv $(h target/validation/rockridge.demand.json) fingerprint $(./target/release/fingerprint)"
log "inputs: $I; membership $(h target/membership/rockridge.membership.json) $(h target/membership/rockridge.membership-training.json)"
[ "$I" = "config 2405ff02c92b2837 network 53c823f20d9165ed demand 2d16d8f8eb0950ca cv 1c3b1666f24156f1 fingerprint $FP" ] || stop "inputs differ"
mkdir -p $A/head
for f in data/calibration/validation.json $(git ls-files data/calibration/reports); do mkdir -p $A/head/$(dirname $f); git show HEAD:$f > $A/head/$f; done

# 3. Validate
step validate ./target/release/validate || stop "validate failed"
log "validate: $(grep -E 'cases pass' $A/validate.log)"
grep -q '67 of 74 cases pass' $A/validate.log || stop "validation is not 67 of 74"
node $A/jdiff.cjs $A/head/data/calibration/validation.json data/calibration/validation.json --ignore manifest.simulator.fingerprint --ignore manifest.simulator.revision > $A/validation-diff.txt 2>&1; RC=$?
log "validation.json: $(tr '\n' ' ' < $A/validation-diff.txt | cut -c1-600)"
git diff --quiet data/calibration/validation.md && log "validation.md unchanged" || { RC=1; log "validation.md changed: $(git diff --stat data/calibration/validation.md | tail -1)"; }
[ $RC = 0 ] || stop "validation changed beyond the fingerprint and revision"

# 3. Published ten-seed assessment
step assess npm run assess -- --publish --noise --jobs 12 || stop "assess failed"
AM=data/calibration/rockridge.assessment.md
grep -q 'Suggested status' $AM || stop "the assessment has no verdict: $(tail -3 $A/assess.log | tr '\n' ' ')"
log "assessment stamp: $(sed -n 7p $AM)"
log "assessment verdict: $(grep -m1 'Suggested status' $AM | cut -c1-200)"
diff <(git show HEAD:$AM | norm) <(norm < $AM) > $A/assessment.diff; N=$(wc -l < $A/assessment.diff | tr -d ' ')
log "assessment vs published, stamps set aside: $N diff lines"
BAD=0; [ $N = 0 ] || BAD=1
for f in $(git ls-files data/calibration/reports); do
  node $A/jdiff.cjs $A/head/$f $f --ignore manifest.simulator.fingerprint --ignore manifest.simulator.revision > $A/report-diff.txt 2>&1 || { BAD=1; log "report $f: $(tr '\n' ' ' < $A/report-diff.txt | cut -c1-400)"; }
done
log "reports: $(git ls-files data/calibration/reports | wc -l | tr -d ' ') tracked, untracked new: $(git status --short --untracked-files=all data/calibration/reports | grep '^??' | wc -l | tr -d ' '); every tracked report identical apart from fingerprint and revision: $([ $BAD = 0 ] && echo yes || echo NO)"
log "changed files: $(git status --short | tr '\n' ';')"
NZ=$(h public/data/rockridge.noise.json)
cmp -s public/data/rockridge.noise.json $PB/rockridge.noise.json && log "noise file identical to the published one ($NZ)" || { BAD=1; log "noise file differs: $NZ vs $(h $PB/rockridge.noise.json)"; node $A/jdiff.cjs $PB/rockridge.noise.json public/data/rockridge.noise.json > $A/noise-diff.txt 2>&1; log "$(head -5 $A/noise-diff.txt | tr '\n' ' ' | cut -c1-400)"; }
[ $BAD = 0 ] || stop "the assessment differs from the published one beyond the stamps"

# 4. Proposal search, round 52 flags, round 52 seeding inputs
rm -rf $S; mkdir -p $S
cp target/batches/search-c5/proposals.json $S/proposals.json
cp target/batches/search-c5/report.md $S/report.md
git show 9c6a679:data/proposals/rockridge.seeds.json > $S/seeds.json
SD="$(h $S/proposals.json) $(h $S/report.md) $(h $S/seeds.json)"
log "seeded proposals.json, report.md, seeds.json: $SD (round 52: 3822705a26ca879d 8a443b947c606e50 fbcf6d37a7e8cad3)"
[ "$SD" = "3822705a26ca879d 8a443b947c606e50 fbcf6d37a7e8cad3" ] || stop "seeding inputs differ from round 52's"
ARGS=(--area rockridge --periods pm_peak,am_peak,midday --seeds 1-3 --confirm-seeds 101-110 --beam 5 --depth 6 --candidates 40 --expand 12 --finalists 12 --options 6 --screen-minutes 20 --minutes 60 --jobs 12 --out $S/proposals.json --report $S/report.md --known $S/seeds.json)
print -r -- "(cwd <worktree>) target/release/explore ${ARGS[*]}" > $S/command.txt
diff <(sed 's#target/[a-z0-9/-]*/##g' $EV52/search/command.txt) <(sed 's#target/[a-z0-9/-]*/##g' $S/command.txt) > /dev/null && log "explore flags identical to round 52's" || stop "explore flags differ from round 52's"
step search ./target/release/explore "${ARGS[@]}" || stop "explore failed"
log "search wall time above; round 52: 5606 s"
log "status after explore: $(git status --short | tr '\n' ';')"
BAD=0
node $A/jdiff.cjs $PB/rockridge.proposals.json $S/proposals.json --ignore groups.*.computed.simulator --ignore groups.*.computed.sourceRevision --ignore groups.*.computed.date > $A/proposals-diff.txt 2>&1 || BAD=1
log "proposals.json: new $(h $S/proposals.json), published $(h $PB/rockridge.proposals.json); $(tr '\n' ' ' < $A/proposals-diff.txt | cut -c1-700)"
diff <(norm < $EV52/search/report.md) <(norm < $S/report.md) > $A/report.diff; N=$(wc -l < $A/report.diff | tr -d ' ')
log "report.md vs published, stamps set aside: $N diff lines"; [ $N = 0 ] || BAD=1
cmp -s $S/seeds.json data/proposals/rockridge.seeds.json && log "seeds.after $(h $S/seeds.json) identical to the committed e464cc90ca3e1472" || { BAD=1; log "seeds.after $(h $S/seeds.json) DIFFERS from the committed $(h data/proposals/rockridge.seeds.json)"; }
[ $BAD = 0 ] || stop "the search differs from the published set beyond the stamps"
rm -rf $K
log "B DONE"
