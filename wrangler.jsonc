{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traffic-transit-directory",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/data/*", "/og/*", "/", "/proposals", "/streets", "/assumptions", "/sources", "/p/*", "/llms.txt", "/llms-full.txt", "/index.md", "/proposals.md", "/streets.md", "/assumptions.md", "/sources.md", "/scenario-links.md", "/data-files.md", "/run-locally.md"]
  },
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "traffic-data" }],
  "observability": { "enabled": true }
}
