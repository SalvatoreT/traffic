{
  "name": "traffic",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "wasm": "sh scripts/build-wasm.sh",
    "check:wasm": "node scripts/check-wasm-parity.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run wasm && npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "data": "tsx tools/import-osm.ts && tsx tools/build-demand.ts && tsx tools/build-assumptions.ts",
    "data:assumptions": "tsx tools/build-assumptions.ts",
    "test": "cargo test --workspace && vitest run",
    "prepare": "git config core.hooksPath .githooks && sh scripts/install-skills.sh",
    "data:pull": "tsx tools/r2-sync.ts pull",
    "data:push": "tsx tools/r2-sync.ts push",
    "data:results": "tsx tools/precompute-results.ts",
    "data:download": "tsx tools/download-data.ts",
    "data:llms": "tsx tools/build-llms.ts",
    "data:previews": "tsx tools/build-previews.ts",
    "simulate": "tsx tools/simulate.ts",
    "data:fetch": "tsx tools/fetch-osm.ts && tsx tools/fetch-demand.ts",
    "cost-loop": "tsx tools/cost-loop.ts",
    "assess": "tsx tools/assess.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.18.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@fission-ai/openspec": "^1.17.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "jpeg-js": "^0.4.4",
    "opentype.js": "^2.0.0",
    "tsx": "^4",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
