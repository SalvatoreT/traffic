{
  "area": "rockridge",
  "network": "public/data/rockridge.network.json",
  "output": "public/data/rockridge.transit.json",
  "areas": "public/data/areas.json",
  "raw": {
    "gtfs": "data/transit/raw/gtfs.zip"
  },
  "feed": {
    "agency": "AC Transit",
    "page": "https://www.actransit.org/data-api-resource-center",
    "downloadUrl": "https://api.actransit.org/transit/gtfs/download",
    "tokenEnv": "ACTRANSIT_TOKEN",
    "tokenNote": "The agency's data page links the GTFS download with an access token issued by the agency. Set ACTRANSIT_TOKEN to it, or pass --file <zip> or --url <url>."
  },
  "periods": [
    { "id": "am_peak", "startHour": 7, "endHour": 9 },
    { "id": "midday", "startHour": 11, "endHour": 13 },
    { "id": "pm_peak", "startHour": 16, "endHour": 18 }
  ],
  "dwellSeconds": 20,
  "dwellNote": "ASSUMPTION: fixed dwell per stop until boarding counts exist; no published value in docs/references.md.",
  "minRouteLengthM": 300,
  "maxStopDistM": 35,
  "minVariantShare": 0.1
}
